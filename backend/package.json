{
  "name": "evidence-correlated-rca-backend",
  "version": "1.0.0",
  "description": "Backend for Evidence-Correlated Root Cause Localization system (SonarQube, Semgrep, Trivy, Gitleaks correlation via LLM reasoning)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "typescript": "^5.5.4",
    "zod": "^3.23.8",
    "mongoose": "^8.5.2",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "cookie-parser": "^1.4.6",
    "express-rate-limit": "^7.4.0",
    "compression": "^1.7.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-jwt": "^4.0.1",
    "express-session": "^1.18.0",
    "simple-git": "^3.25.0",
    "@octokit/rest": "^21.0.2",
    "@octokit/webhooks": "^13.2.7",
    "axios": "^1.7.5",
    "@pinecone-database/pinecone": "^3.0.2",
    "nodemailer": "^6.9.14",
    "@slack/web-api": "^7.3.4",
    "winston": "^3.14.2",
    "node-cron": "^3.0.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.4.1",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/cookie-parser": "^1.4.7",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/passport": "^1.0.16",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/express-session": "^1.18.0",
    "@types/uuid": "^10.0.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.9.1",
    "@typescript-eslint/parser": "^8.2.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "prettier": "^3.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "@types/jest": "^29.5.12",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.0"
  }
}